# Git tự chuẩn hóa xuống dòng cho file text, tránh diff giả giữa các máy
* text=auto

# Script phải giữ đúng kiểu xuống dòng thì mới chạy được
mvnw        text eol=lf
*.sh        text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# File nhị phân: không chuẩn hóa, không diff
*.jar       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.mp3       binary
*.wav       binary
*.ogg       binary
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.pptx      binary

# C4 raw phải giữ nguyên byte để summary SHA256 tái tạo trên mọi máy.
evidence/t1-c4/raw/*.jsonl -text
evidence/t1-c4/*.json text eol=lf
evidence/t1-c4/*.csv text eol=lf
evidence/t1-c4/*.txt text eol=lf

# T2-C1 artifact checksums cover exact bytes, including metadata and summaries.
evidence/t2-c1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# T2-C2 raw, metadata and summaries retain the exact verified bytes.
evidence/t2-c2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Observation trace checksums include exact UTF-8/LF bytes.
client/src/test/resources/monitoring-traces/*.jsonl -text whitespace=cr-at-eol
evidence/t2-c3/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# C4 ground truth, observation and manifest checksums retain exact bytes.
evidence/t2-c4/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Backend P0 evidence checksums cover exact captured bytes (Windows logs may use CRLF).
evidence/t2-a-p0/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

# T3-C1 trace/replay/transcript checksums cover exact bytes.
evidence/t3-c1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Backend P0/main synchronization evidence retains exact captured bytes.
evidence/t2-a-p0-sync/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

# T3-C2 verification artifacts retain exact bytes/checksums.
evidence/t3-c2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# C3 fixture manifest hashes and replay artifact hashes cover exact bytes.
client/src/test/resources/monitoring-traces/t3-c3/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
evidence/t3-c3/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# T3-C4 raw archives, manifests, screenshots and transcripts retain verified exact bytes.
evidence/t3-c4/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

# T3-A1 transcript hashes must survive Git checkout without newline conversion.
evidence/t3-a1/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

# T3-A2 transcripts and audit hashes retain exact captured bytes.
evidence/t3-a2/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

# T3-B1 package transcripts, screenshots and audit hashes retain verified bytes.
evidence/t3-b1/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

# T3-B2 package transcripts, playback journal and screenshots retain verified bytes.
evidence/t3-b2/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
