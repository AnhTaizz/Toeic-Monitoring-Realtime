# Chép file này thành .env rồi sửa giá trị cho máy mình. File .env không được commit.
DB_NAME=toeic
DB_USER=toeic
DB_PASSWORD=doi_mat_khau_nay
# Nếu máy đã cài PostgreSQL trực tiếp (đang chiếm 5432) thì đổi sang port khác, ví dụ 5433
DB_PORT=5432
# Audio do người tổ chức cấp: <thư mục này>/<examId>/<audioFile>.
TOEIC_AUDIO_ROOT=audio-resources
# Images are operator-provisioned outside the database/JAR: <root>/<examId>/<localFile>.
TOEIC_IMAGE_ROOT=image-resources
# Chỉ cho phát triển/kiểm thử: tạo candidate1, candidate2, proctor1 (MOCK) nếu chưa có, với mật khẩu dưới đây.
# Server không có mật khẩu demo mặc định; bản phát hành (Start-Server.bat) luôn tắt tài khoản demo.
TOEIC_SEED_DEMO_ACCOUNTS=true
TOEIC_SEED_PASSWORD=ChangeMe123!
# ACCOUNT_PIN only: persistent base64url HMAC key, at least 32 random bytes.
# Generate once using the command in docs/account-pin/RUNBOOK.md; never commit a real key.
TOEIC_ROOM_PIN_KEY=
