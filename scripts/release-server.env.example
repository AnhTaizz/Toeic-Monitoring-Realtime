# TOEIC Monitor Server settings. Copy this file to "server.env" in the same folder
# as Start-Server.bat, then fill in every value. Keep server.env private: do not
# copy it into a ZIP, screenshot, chat or Git. Start-Client.bat does not need it.

# PostgreSQL that already exists on the Server machine (do not expose it to the LAN).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=toeic
DB_USER=toeic
DB_PASSWORD=

# Password for the built-in MOCK development accounts; choose a private value.
TOEIC_SEED_PASSWORD=

# Absolute folders that hold the imported exam media: <root>/<examId>/<file>.
# STUDY4 exams need the STUDY4 roots produced by tools/study4-adapter, not MOCK media.
# Paths may contain spaces and Vietnamese characters.
TOEIC_AUDIO_ROOT=
TOEIC_IMAGE_ROOT=

# ACCOUNT_PIN: base64url of at least 32 random bytes. Generate ONCE (READ-ME.txt)
# and keep it unchanged; a new key makes existing room PINs unusable.
TOEIC_ROOM_PIN_KEY=

# First Admin account, created only if that username does not exist yet. Password:
# 20-72 bytes, private, different from TOEIC_SEED_PASSWORD. Both lines may be
# cleared after the first successful start.
TOEIC_ADMIN_BOOTSTRAP_USERNAME=
TOEIC_ADMIN_BOOTSTRAP_PASSWORD=
